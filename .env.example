# pf-web-frontend-client — variables de entorno
#
# Copia este archivo a .env.local y rellena los valores. Nada de secretos aqui:
# todo lo que lleve prefijo VITE_ acaba en el bundle y es publico por definicion.

# --- La superficie HTTP ---
# bff: la unica superficie HTTP de comandos y consultas.
VITE_API_BASE_URL=http://localhost:8080

# El stream SSE de `realtime` era V2 y se retiro del release path de V1 (E9-T10 /
# F-06). Ya no hay VITE_STREAM_BASE_URL. Ver prototipos-v2/seguimiento-vivo/.

# --- Identidad ---
# El login va contra bff (POST /api/v1/sesion), no contra Cognito directamente.
# Estas variables existen solo para el caso en que se decida el flujo hosted UI.
# TODO(auth): confirmar si hacen falta. Ver "decisiones abiertas" en el README.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# --- Generacion de contratos ---
# Ruta al monorepo backend que contiene contracts/openapi/bff.yaml.
# TODO(contracts): no existe todavia en este workspace. Ver README.
CONTRACTS_DIR=

# --- Mocks ---
# No lo pongas aqui: usa `pnpm dev:mock`, que carga .env.mock. Se documenta solo para
# que se sepa que existe. Con los mocks activos hay un `bff` simulado en src/mocks/, y
# se entra con cliente@demo.ai27 / demo1234.
# VITE_ENABLE_MOCKS=true
