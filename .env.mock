# Modo mock: `pnpm dev:mock` y `pnpm build:mock`.
#
# Vite da mas prioridad a .env.[mode] que a .env.local, asi que este archivo gana
# cuando se corre con --mode mock, sin tocar tu configuracion local.

VITE_ENABLE_MOCKS=true

# Vacio = mismo origen. MSW intercepta antes de que la peticion salga.
VITE_API_BASE_URL=

# El stream SSE de `realtime` era V2 y se retiro del release path de V1 (E9-T10 /
# F-06): ya no hay VITE_STREAM_BASE_URL. Ver prototipos-v2/seguimiento-vivo/.
